<style>
  /* Header text color changes when scrolled */
  .header-scrolled .header-logo-text { color: #1e3a5f !important; }
  .header-scrolled #desktop-nav a,
  .header-scrolled #desktop-nav button { color: rgba(30,58,95,0.8) !important; }
  .header-scrolled #desktop-nav a:hover,
  .header-scrolled #desktop-nav button:hover { color: #2F80ED !important; background: rgba(47,128,237,0.06) !important; }
  .header-scrolled .hamburger-bar { background: #1e3a5f !important; }
  .header-scrolled .header-logo-text span { color: #F59E0B !important; }
  /* Hamburger active animation */
  .hamburger-bar.active:nth-child(1) { transform: translateY(4px) rotate(45deg); }
  .hamburger-bar.active:nth-child(2) { opacity: 0; }
  .hamburger-bar.active:nth-child(3) { width: 1.5rem; transform: translateY(-4px) rotate(-45deg); }
</style>
